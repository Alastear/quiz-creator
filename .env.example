# ===== Quibby environment (DESIGN.md ข้อ 6.2) =====
# คัดลอกไฟล์นี้เป็น .env.local แล้วปรับค่าตามต้องการ
#   cp .env.example .env.local

# --- Database (Postgres ทั้ง local และ prod) ---
# Local (docker-compose): ค่าด้านล่างใช้ได้เลย
# Prod: ใส่ connection string ของ Neon
DATABASE_URL="postgres://quibby:quibby_dev@localhost:5435/quibby"

# --- Adapters: เลือก driver ตาม environment ---
# Media storage:   local (filesystem) | blob (Vercel Blob)
STORAGE_DRIVER="local"
# โฟลเดอร์เก็บไฟล์ตอนใช้ STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=".uploads"

# Rate limit:      memory (in-process, dev only) | upstash
RATELIMIT_DRIVER="memory"

# Email:           console (log magic link) | resend
EMAIL_DRIVER="console"

# --- Prod-only (เว้นว่างได้ตอน local) ---
# Vercel Blob
BLOB_READ_WRITE_TOKEN=""
# Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Resend
RESEND_API_KEY=""
EMAIL_FROM="Quibby <noreply@quibby.app>"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# secret สำหรับป้องกัน endpoint cron (DESIGN.md ข้อ 9.3)
CRON_SECRET="dev-cron-secret-change-me"
